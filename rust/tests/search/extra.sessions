# Sessions for direct comparisons with the reference binary (bench/compare_uci.py),
# reaching what the corpus of the trace does not or rarely does. See README.md,
# "What the gates do not see". `go` may take any argument but a clock here.
# Mates and stalemates, at the root and in the tree
position fen 7k/5Q2/6K1/8/8/8/8/8 b - - 0 1 ; go depth 5
position fen 6k1/5Q2/6K1/8/8/8/8/8 b - - 0 1 ; go depth 5
position fen k7/8/1Q6/8/8/8/8/7K w - - 0 1 ; go depth 12
position fen 8/8/8/8/8/2k5/2p5/2K5 w - - 0 1 ; go depth 16
position fen 8/8/8/8/4k3/8/8/R3K3 w Q - 0 1 ; go nodes 100000
position fen 6k1/5ppp/8/8/8/8/5PPP/R5K1 w - - 0 1 ; go depth 12
position fen 8/8/8/8/8/5k2/4q3/7K w - - 0 1 ; go depth 10
# A mate found then lost by a node-limited iteration, and go mate
position fen r1bqkbnr/pppp1ppp/2n5/4p3/2B1P3/5Q2/PPPP1PPP/RNB1K1NR w KQkq - 0 1 ; go nodes 3000 ; go nodes 5000 ; go nodes 7000
position fen 2r3k1/5ppp/8/8/8/8/5PPP/1R4K1 w - - 0 1 ; go mate 3 nodes 2000000
position fen 6k1/5ppp/8/8/8/8/5PPP/R5K1 w - - 0 1 ; go mate 1
position fen 6k1/5ppp/8/8/8/8/1Q3PPP/6K1 w - - 0 1 ; go mate 2 depth 30
position fen r5k1/5ppp/8/8/8/8/5PPP/6K1 b - - 0 1 ; go mate 1 depth 20
position fen 6k1/6pp/8/8/8/8/1Q4PP/6K1 w - - 0 1 ; go mate 5 nodes 2000000
position fen 8/8/8/8/4k3/8/8/R3K3 w Q - 0 1 ; go mate 12 nodes 2000000
# The 50-move rule close to 100, with and without TT cutoffs
position fen 8/5k2/8/3R4/8/8/2K5/4r3 w - - 95 120 ; go depth 14
position fen 8/5k2/8/3R4/8/8/2K5/4r3 w - - 99 120 ; go depth 12
position fen 4k3/8/8/8/8/8/3QK3/8 w - - 90 80 ; go depth 14
# searchmoves
position startpos ; go depth 10 searchmoves e2e4 d2d4 g1f3
position startpos moves e2e4 e7e5 ; go depth 9 searchmoves b1c3
# Long searches: currmove lines and the output on aspiration failures (more than 10M nodes)
position fen r1bq1rk1/pp2bppp/2n1pn2/2pp4/3P4/2PBPN2/PP1N1PPP/R1BQ1RK1 w - - 0 9 ; go nodes 11000000
# go infinite: the search reaches its depth limit and waits for stop
position startpos moves e2e4 c7c5 ; go infinite depth 12 ; stop
position fen 6k1/5ppp/8/8/8/8/5PPP/R5K1 w - - 0 1 ; go infinite depth 6 ; stop
