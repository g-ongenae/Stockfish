# Members of the `dump` and `dumpline` outputs that the Rust port reproduces,
# as the comma-separated lists `tests/differential/verify.sh --fields` takes.
# Read by the README's instructions and by .github/workflows/rust.yml: when a
# layer is ported, add its members here, and CI checks them on every target.
#
# DUMPLINE_FIELDS empty would make CI skip `verify.sh lines` (and say so in
# the log). nnue and eval need the network (see README.md).
DUMP_FIELDS=fen,chess960,checkers,blockers_for_king,pinners,check_squares,threats,key,pawn_key,material_key,minor_piece_key,non_pawn_key,non_pawn_material,nnue,eval,moves,gives_check,key_after,see
DUMPLINE_FIELDS=ply,move,fen,key,pawn_key,material_key,minor_piece_key,non_pawn_key,non_pawn_material,checkers,blockers_for_king,pinners,check_squares,threats,captured,plies_from_null,repetition,is_draw,has_repeated,upcoming_repetition,nnue,eval,null,probe,undo,keys,fens,nnues
