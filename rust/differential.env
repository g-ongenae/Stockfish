# Members of the `dump` and `dumpline` outputs that the Rust port reproduces,
# as the comma-separated lists `tests/differential/verify.sh --fields` takes.
# Read by the README's instructions and by .github/workflows/rust.yml: when a
# layer is ported, add its members here, and CI checks them on every target.
#
# DUMPLINE_FIELDS stays empty while `dumpline` is not ported; CI then skips
# `verify.sh lines` (and says so in the log). Once it is set, CI runs it.
DUMP_FIELDS=fen,chess960,checkers,blockers_for_king,pinners,check_squares,threats,key,pawn_key,material_key,minor_piece_key,non_pawn_key,non_pawn_material,moves,gives_check,key_after,see
DUMPLINE_FIELDS=
